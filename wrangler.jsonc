{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notes",
  "main": "worker.js",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/pdf/*",
      "/pdfs/*",
      "/sign"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
